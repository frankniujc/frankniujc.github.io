---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListPosts from '@/components/ListPosts.astro'
import siteConfig from '@/site-config'
import { getPosts } from '@/utils/posts'

import newsRaw from '@/data/news.md?raw'

const newsItems = newsRaw
  .split('\n')
  .filter((l) => l.startsWith('- '))
  .slice(0, 6)
  .map((l) =>
    l
      .replace(/^- /, '')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>'),
  )

const featuredPubs = (await getPosts(undefined, 'pubs')).filter((p) => p.data.featured)
---

<BaseLayout description={siteConfig.description}>
  <article class="prose">
    <h1 class="text-title">Jingcheng (Frank) Niu</h1>

    <section class="profile flex flex-col md:flex-row md:items-start gap-6">
      <img src="/profile-photo.jpg" alt="Jingcheng Niu" class="profile__photo" />
      <div class="profile__intro">
        <p>
          Hi! I am a Member of Technical Staff (MTS) at
          <a class="underline decoration-dashed underline-offset-4 hover:text-skin-accent" href="https://veeda.ai/"
            >Veeda AI</a
          >.
        </p>
        <p>
          Previously, I was a postdoctoral researcher at the
          <a
            class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
            href="https://www.informatik.tu-darmstadt.de/ukp/ukp_home/index.en.jsp">UKP Lab</a
          >
          @<a
            class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
            href="https://www.informatik.tu-darmstadt.de/fb20/index.en.jsp">TU Darmstadt</a
          >, working with Professor
          <a
            class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
            href="https://www.informatik.tu-darmstadt.de/ukp/ukp_home/head_ukp/index.en.jsp">Iryna Gurevych</a
          >. I did my PhD at the
          <a
            class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
            href="https://www.cs.toronto.edu/compling/">Computational Linguistics Group @UofT</a
          >, advised by Professor
          <a
            class="underline decoration-dashed underline-offset-4 hover:text-skin-accent"
            href="http://www.cs.toronto.edu/~gpenn/">Gerald Penn</a
          >. 牛靖程 is my name in Chinese.
        </p>
        <p>
          I am interested in <b class="text-skin-accent">LLM Interpretability</b>. You can find my research on the <a
            href="/publications">List of Publications</a
          >.
        </p>
      </div>
    </section>

    <p class="flex flex-wrap justify-center gap-x-4 gap-y-2">
      <a href="/cv.pdf">Curriculum Vitae</a>
      {
        siteConfig.socialLinks.map((link) => (
          <a aria-label={link.text} href={link.href} target="_blank" class="prose-link">
            <i class:list={[link.icon]} />
            {link.text}
          </a>
        ))
      }
    </p>

    <p class="contact">
      Feel free to email me about my research! I'm also happy to discuss research-related topics, grad school
      applications, or careers in AI/NLP. Email: <b class="text-skin-accent">frankniujc at gmail dot com</b>.
    </p>

    <section id="news">
      <h2>News</h2>
      <ul>
        {newsItems.map((item) => <li set:html={item} />)}
      </ul>
    </section>

    <section id="selected-publications">
      <h2>Selected Publications</h2>
      <div class="not-prose">
        <ListPosts list={featuredPubs} showYearHeader={false} />
      </div>
      <a href="/publications" class="text-sm opacity-60 hover:opacity-100">View all publications →</a>
    </section>
  </article>
</BaseLayout>
