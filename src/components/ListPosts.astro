---
import BibEntry from './BibEntry.astro'
import { processAuthor } from '@/utils/author'
/* ------------------------------------------------------------------ */
/*  Type definitions + props                                          */
/* ------------------------------------------------------------------ */
interface Post {
  id: string
  slug: string
  body: string
  data: Record<string, any>
  collection: string
  render: any
}

export interface Props {
  list?: Post[]
  showYearHeader?: boolean
}

const { list = [], showYearHeader = true } = Astro.props

/* ------------------------------------------------------------------ */
/*  Helper functions (ported 1 : 1 from the Vue version)               */
/* ------------------------------------------------------------------ */
const getDate = (d: string) => new Date(d).toISOString()

const getHref = (post: Post) => (post.data.redirect ? post.data.redirect : `/publications/${post.slug}`)

const getTarget = (post: Post) => (post.data.redirect ? '_blank' : '_self')

const getYear = (d: Date | string | number) => new Date(d).getFullYear()
const isSameYear = (a: Date | string | number, b: Date | string | number) => !!a && !!b && getYear(a) === getYear(b)

/* ----------  badge helpers  --------------------------------------- */
type Meta = { icon: string; label: string }

const meta: Record<string, Meta> = {
  pdf: { icon: 'i-tabler-pdf', label: 'PDF' },
  code: { icon: 'i-ri-github-fill', label: 'Code' },
  data: { icon: 'i-ri-database-2-line', label: 'Dataset' },
  slides: { icon: 'i-ri-slideshow-4-line', label: 'Slides' },
  poster: { icon: 'i-ri-image-line', label: 'Poster' },
  talk: { icon: 'i-carbon-logo-youtube', label: 'Talk' },
  demo: { icon: 'i-ri-links-line', label: 'Live demo' },
}

/* bare icon+text links, same voice as the hero's social links. The faint underline lives on the
   label span (text-decoration, not border-b) because `.prose .not-prose a` kills border-bottom
   and flex containers don't propagate text decorations anyway */
const badgeClass =
  'group inline-flex items-center gap-1 text-sm cursor-pointer !border-none text-truegray-600 dark:text-truegray-400 hover:text-truegray-900 dark:hover:text-truegray-100 transition-colors duration-200'
const badgeLabelClass =
  'underline underline-offset-4 decoration-truegray-500/40 group-hover:decoration-truegray-500 dark:decoration-truegray-400/40 dark:group-hover:decoration-truegray-400'

const makeBadge = (name: string, url?: string) => {
  if (!url) return ''
  const { icon, label } = meta[name.toLowerCase()] ?? {
    icon: 'i-ri-external-link-line',
    label: name,
  }
  return `
    <a href="${url}" target="_blank" rel="noopener noreferrer" class="${badgeClass}">
      <i class="${icon} text-base"></i><span class="${badgeLabelClass}">${label}</span>
    </a>`
}

const paperTag = (url?: string, label = 'PDF') => makeBadge('pdf', url).replace('PDF', label)
const codeTag = (url?: string) => makeBadge('code', url)
const posterTag = (url?: string) => makeBadge('poster', url)
const talkTag = (url?: string) => makeBadge('talk', url)
const slidesTag = (url?: string) => makeBadge('slides', url)
const demoTag = (url?: string) => makeBadge('demo', url)

const hasBibtex = (post: Post) => /```bibtex/.test(post.body ?? '')

const bibTag = (id: string, label = 'BibTeX') => `
  <a onclick="toggleBibtex('${id}')" class="${badgeClass}">
     <i class="i-file-icons-bibtex text-base"></i><span class="${badgeLabelClass}">${label}</span>
  </a>
`

/* the one colour accent in the list: award / honour pill */
const notePill = (note: string) => `
  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-xs font-500 border border-red-200 bg-red-50 text-red-700 dark:border-red-300/20 dark:bg-red-400/10 dark:text-red-300">
    <i class="i-ri-award-line text-sm"></i><span>${note}</span>
  </span>`

const badgeRow = (post: Post) =>
  [
    paperTag(post.data.paper, post.data.paper_linkname),
    codeTag(post.data.code),
    posterTag(post.data.poster),
    talkTag(post.data.talk),
    slidesTag(post.data.slides),
    hasBibtex(post) ? bibTag(post.id) : '',
  ]
    .filter(Boolean)
    .join('')
---

<!-- ------------------------------------------------------------------ --><!--  Mark-up                                                           --><!-- ------------------------------------------------------------------ -->
<ul class={`mb-4 ${showYearHeader ? 'min-h-28 mb-18 sm:min-h-38' : 'pub-compact'}`}>
  {list.length === 0 && <div class="my-12 opacity-50">nothing here yet.</div>}

  {
    list.map((post, idx) => (
      <li class={showYearHeader ? 'mb-10' : '!mb-12'}>
        {/* year header */}
        {showYearHeader && !isSameYear(post.data.date, list[idx - 1]?.data.date) && (
          <div class="relative h18 select-none pointer-events-none">
            <span
              class="absolute -top-[0.2em] text-[7em] font-bold text-transparent
                       text-stroke-2 text-stroke-hex-aaa op14"
            >
              {getYear(post.data.date)}
            </span>
          </div>
        )}

        {/* title line */}
        <a
          class="flex flex-col gap-2 text-lg lh-tight font-600 text-link decoration-none !border-none transition-opacity duration-200 hover:opacity-75"
          aria-label={post.data.title}
          target={getTarget(post)}
          href={getHref(post)}
        >
          <div class="flex flex-col gap-2 md:flex-row md:items-center">
            <div class="flex items-center gap-2 text-wrap">
              {post.data.draft && <i class="i-ri-draft-line text-base align-middle" />}
              {post.data.title}
            </div>
          </div>
        </a>

        {/* venue + award */}
        {post.data.venue && (
          <div class="mt-1 flex flex-wrap items-center gap-2 text-sm">
            <span class="font-600 text-truegray-500 dark:text-truegray-400">{post.data.venue}</span>
            {post.data.note && <span set:html={notePill(post.data.note)} />}
          </div>
        )}

        {/* authors */}
        <div class="mt-1">
          {post.data.authors.map((a: string, i: number) => (
            <span set:html={processAuthor(a, i, post.data.authors.length)} />
          ))}
        </div>

        {/* badges */}
        <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1" set:html={badgeRow(post)} />

        <BibEntry post={post} />
      </li>
    ))
  }
</ul>

<!-- The copy-button and BibTeX-toggle scripts live in the layouts (BaseLayout/TeachingLayout). -->
