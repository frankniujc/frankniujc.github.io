---
import { codeToHtml } from 'shiki'

const { post } = Astro.props

const match = post.body?.match(/```bibtex\r?\n([\s\S]+?)```/)
const bibtex = match?.[1]?.trim()

const highlighted = bibtex
  ? await codeToHtml(bibtex, {
      lang: 'bibtex',
      themes: { light: 'github-light-default', dark: 'github-dark-default' },
    })
  : null
---

{
  highlighted && (
    <div id={post.id.replace(/\.(md|mdx)$/i, '')} style={{ clear: 'both', display: 'none' }}>
      <article class="prose !min-h-0 my-4">
        <div set:html={highlighted} />
      </article>
    </div>
  )
}
